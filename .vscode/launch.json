{
    "version": "0.2.0",
    "configurations": [
        // --- Конфигурация для Django ---
        {
            "name": "Python: Django Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver"
            ],
            "django": true,
            "justMyCode": true
        },

        // --- Конфигурация для FastAPI (через Uvicorn) ---
        {
            "name": "Python: FastAPI (Uvicorn)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",          // Убедитесь, что ваш файл называется main.py
                "--reload",
                "--port", "8000"
            ],
            "jinja": true,
            "justMyCode": true
        },

        // --- Запуск текущего одиночного файла ---
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}